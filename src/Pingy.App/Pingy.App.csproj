<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pingy</AssemblyName>
    <RootNamespace>Pingy.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets/pingy.ico</ApplicationIcon>
    <Description>Portable multi-host ping monitor</Description>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pingy.Core/Pingy.Core.csproj" />
    <EmbeddedResource Include="Assets/pingy.ico" LogicalName="Pingy.icon.ico" />
    <EmbeddedResource Include="defaults.json" LogicalName="Pingy.defaults.json" />
  </ItemGroup>
</Project>
